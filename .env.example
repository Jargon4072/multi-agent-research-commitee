# ============================================================
# Battery Research Multi-Agent System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API key(s).
# Only ONE provider key is required depending on --provider flag.

# ------------------------------------------------------------
# Anthropic Claude (default provider)
# Get your key at: https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model to use for sub-agents (fast + cost-effective)
# Options: claude-haiku-4-5, claude-sonnet-4-5, claude-opus-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Model to use for the synthesis step (higher quality)
ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-4-5

# ------------------------------------------------------------
# Google Gemini (alternative provider, use --provider gemini)
# Get your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (default shown)
LLM_MODEL=gemini/gemini-2.5-flash

# ------------------------------------------------------------
# General settings
# ------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING
